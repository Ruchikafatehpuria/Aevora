DATABASE_URL="postgresql://user:password@localhost:5432/syncly"
DIRECT_URL="postgresql://user:password@localhost:5432/syncly"
APP_URL="http://localhost:3000"
# Required in production. In development, if SMTP_HOST is empty, emails are logged to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Syncly <no-reply@example.com>"
# Used by AI modules (not required for the foundation)
ANTHROPIC_API_KEY=""

# Locker
FILE_URL_SECRET=""   # random 32+ byte hex, signs download URLs
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="200"
STORAGE_QUOTA_MB="5120"

# AI providers. Tried in AI_PROVIDERS order; providers without keys are skipped. Any one is enough.
AI_PROVIDERS="gemini,groq,cloudflare,anthropic"
GEMINI_API_KEY=""            # https://aistudio.google.com/apikey
GEMINI_MODEL=""              # optional, comma-separated list tried in order
GROQ_API_KEY=""              # https://console.groq.com/keys
GROQ_MODEL=""                # optional, default openai/gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=""     # Cloudflare dashboard → Workers AI
CLOUDFLARE_API_TOKEN=""      # token with "Workers AI" permission
CLOUDFLARE_AI_MODEL=""       # optional, default @cf/meta/llama-3.3-70b-instruct-fp8-fast

# File storage: "local" (STORAGE_DIR) or "s3" (Supabase Storage, Cloudflare R2, AWS S3...). Use a PRIVATE bucket.
STORAGE_DRIVER="local"
S3_ENDPOINT=""               # Supabase: https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=""                 # Supabase: your project's region, e.g. ap-south-1
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
